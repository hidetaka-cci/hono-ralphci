{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "matcher": "git commit",
        "command": "cd ${CURSOR_PROJECT_DIR:-.} && npm ci && npm test",
        "timeout": 360
      }
    ],
    "stop": [
      {
        "command": "chunk validate",
        "timeout": 600
      }
    ]
  }
}
